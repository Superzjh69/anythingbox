# ── AI 服务（可选）────────────────────────────────────────────
# 不配置也能使用全部本地功能；配置后才能使用 AI 总结 / 重点提取 / 文档问答
# 支持任意 OpenAI 兼容接口：OpenAI / Azure OpenAI / DeepSeek / Ollama / LM Studio 等

# API 密钥（必填才能启用 AI）
AI_API_KEY=

# 接口地址，默认 OpenAI 官方；例如 DeepSeek: https://api.deepseek.com/v1
AI_BASE_URL=https://api.openai.com/v1

# 模型名称
AI_MODEL=gpt-4o-mini

# AI 请求超时（毫秒），范围 5000 - 300000
AI_TIMEOUT_MS=60000

# ── 上传限额 ──────────────────────────────────────────────────
# 单文件大小上限（MB），范围 1 - 200
MAX_FILE_SIZE_MB=20

# 单次上传文件数量上限，范围 1 - 50
MAX_FILES_PER_UPLOAD=20

# ── 存储 ─────────────────────────────────────────────────────
# 数据目录（相对于项目根目录），包含 uploads / results / meta
DATA_DIR=.data
